@{
    var adminName = Context.Session.GetString("CustomerName");
    var adminImage = Context.Session.GetString("CustomerImage");
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spark Admin - Premium Bootstrap 5 Admin Dashboard Template</title>

    <!-- SEO Optimization -->
    <meta name="description" content="Spark Admin - Premium Bootstrap 5 Admin Dashboard Template">
    <meta name="author" content="Spark Admin Team">

    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico">

    <link rel="stylesheet" href="~/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/libs/apexcharts/apexcharts.css">
    <link rel="stylesheet" href="~/assets/libs/flatpickr/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/assets/css/main.css">
    <style>
            /* Page shifting/sliding ko rokne ke liye clean CSS */
            html {
                overflow-y: scroll !important;
                box-sizing: border-box;
            }

            *, *:before, *:after {
                box-sizing: inherit;
            }

            body {
                display: flex;
                min-height: 100vh;
                flex-direction: column;
                margin: 0;
                background-color: #f8f9fa;
                overflow-x: hidden !important;
            }

            /* Fixed Sidebar Alignment with Dark Theme preserved */
            .sidebar-wrapper {
                position: fixed;
                top: 0;
                left: 0;
                width: 280px;
                height: 100vh;
                z-index: 1050;
                overflow-y: auto;
                transition: transform 0.3s ease-in-out;
            }

            /* Main Content Wrapper - Sidebar ke liye space chhodne ke liye */
            .main-content-wrapper {
                display: flex;
                flex-direction: column;
                flex: 1;
                min-height: 100vh;
                margin-left: 0;
                width: 100%;
            }

            @@media (min-width: 992px) {
                .main-content-wrapper {
                    margin-left: 280px;
                    width: calc(100% - 280px);
                }
            }

            /* Mobile responsive sidebar handling */
            @@media (max-width: 991.98px) {
                .sidebar-wrapper {
                    transform: translateX(-100%);
                }

                    .sidebar-wrapper.sidebar-open {
                        transform: translateX(0);
                    }
            }

            /* Footer Alignment at Bottom */
            .footer-custom {
                margin-top: auto;
            }
    </style>
</head>

<body>

    <!-- START: Sidebar Component -->
    <div class="sidebar-wrapper" id="sidebar">
        <!-- Brand Logo / Identity -->
        <a href="index.html" class="sidebar-brand">
            <i class="bi bi-asterisk"></i>
            <span>Spark Admin</span>
        </a>

        <!-- Navigation Menu -->
        <div class="flex-grow-1 overflow-y-auto">
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Menu</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a href="index.html" class="sidebar-menu-link active" id="menu-overview" title="Overview">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Group: Components -->
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Components</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a asp-controller="Admin" asp-action="AdminPage" class="sidebar-menu-link" title="Home">
                            <i class="bi bi-table"></i>
                            <span>Home</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="Admin" asp-action="ManageAdmins" class="sidebar-menu-link" title="Staff and Admins">
                            <i class="bi bi-person-badge"></i>
                            <span>Staff / Admins</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="Admin" asp-action="ManageCustomers" class="sidebar-menu-link" title="Customer List">
                            <i class="bi bi-people"></i>
                            <span>Customers</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="Admin" asp-action="AddCategory" class="sidebar-menu-link" title="Add Category">
                            <i class="bi bi-menu-button-wide-fill"></i>
                            <span>Category</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="Admin" asp-action="AddProduct" class="sidebar-menu-link" title="Add Product">
                            <i class="bi bi-menu-button-wide-fill"></i>
                            <span>Product</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" title="Cart">
                            <i class="bi bi-menu-button-wide-fill"></i>
                            <span>Cart</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" title="Order">
                            <i class="bi bi-menu-button-wide-fill"></i>
                            <span>Order</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Sidebar Profile Card -->
        <div class="sidebar-profile">
            <img src="~/Upload/@adminImage" alt="Administrator" class="sidebar-profile-img">
            <div class="sidebar-profile-info">
                <div class="sidebar-profile-name">@adminName</div>
                <div class="sidebar-profile-email">Administrator</div>
            </div>
        </div>
    </div>
    <!-- END: Sidebar Component -->
    <!-- START: Main Content Area -->
    <main class="main-content-wrapper">
        <!-- Top Header Bar with Profile Dropdown -->
        <header class="navbar navbar-expand px-4 py-2 border-bottom bg-white justify-content-between justify-content-lg-end">

            <!-- Toggle Menu Icon Button -->
            <button class="btn btn-outline-secondary d-lg-none btn-sm" type="button" id="sidebarToggle">
                <i class="bi bi-list fs-5"></i>
            </button>

            <div class="dropdown ms-2">
                <button class="navbar-profile-btn dropdown-toggle btn d-flex align-items-center gap-2 border-0 bg-transparent"
                        type="button" data-bs-toggle="dropdown"
                        aria-expanded="false" id="profile-dropdown">

                    <img src="~/Upload/@adminImage" alt="Profile Image"
                         class="navbar-profile-img rounded-circle"
                         width="32" height="32">

                    <span class="navbar-profile-name d-none d-md-inline fw-semibold">
                        @adminName
                    </span>

                    <i class="bi bi-chevron-down navbar-profile-caret small"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile shadow-sm" aria-labelledby="profile-dropdown">
                    <li class="dropdown-header text-muted small">Welcome !</li>
                    <li>
                        <a class="dropdown-item" asp-controller="Admin" asp-action="ManageAdmins">
                            <i class="bi bi-person me-2"></i> My Account
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </header>

        <!-- Main Body Content -->
        <div class="container-fluid py-4 flex-grow-1">
            @RenderBody()
        </div>

        <footer class="footer-custom">
            <div class="footer-left">
                <span class="footer-logo">
                    <i class="bi bi-asterisk"></i> Spark Admin
                </span>
                <span class="footer-separator">|</span>
                <span class="footer-copy">&copy; 2026 Spark Admin. All rights reserved.</span>
            </div>
            <div class="footer-right">
                <a href="#" class="footer-link">Support</a>
            </div>
        </footer>
    </main>

    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
    <script src="~/assets/js/dashboard.js"></script>

    <!-- Script for Mobile Sidebar Toggle -->
    <script>
            document.getElementById('sidebarToggle').addEventListener('click', function () {
                document.getElementById('sidebar').classList.toggle('sidebar-open');
            });
    </script>
</body>

</html>