 <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <h1>Contact Us</h1>
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Contact Us</li>
          </ol>
        </nav>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-5">
            <article class="contact-card h-100">
              <h2>Store details</h2>
              <p>Send a question about an order, a product, or a return. We reply during store hours.</p>
              <div class="info-row">
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                <p>12-B, Commercial Lane<br>DHA Phase 6, Karachi, Pakistan</p>
              </div>
              <div class="info-row">
                <i class="bi bi-telephone" aria-hidden="true"></i>
                <p><a href="tel:+922112345678">+92 21 1234 5678</a></p>
              </div>
              <div class="info-row">
                <i class="bi bi-envelope" aria-hidden="true"></i>
                <p><a href="mailto:hello@shopnest.pk">hello@shopnest.pk</a></p>
              </div>
              <div class="info-row mb-0">
                <i class="bi bi-clock" aria-hidden="true"></i>
                <p>Monday to Saturday<br>9:00 AM – 9:00 PM</p>
              </div>
            </article>
          </div>
          <div class="col-lg-7">
            <article class="contact-card">
              <h2>Send a message</h2>
              <form class="contact-form" action="contact.html" method="get">
                <div class="mb-3">
                  <label class="form-label" for="name">Name</label>
                  <input class="form-control" type="text" id="name" name="Name" maxlength="80" required autocomplete="name">
                </div>
                <div class="mb-3">
                  <label class="form-label" for="email">Email</label>
                  <input class="form-control" type="email" id="email" name="Email" maxlength="120" required autocomplete="email">
                </div>
                <div class="mb-3">
                  <label class="form-label" for="subject">Subject</label>
                  <input class="form-control" type="text" id="subject" name="Subject" maxlength="120" required>
                </div>
                <div class="mb-3">
                  <label class="form-label" for="message">Message</label>
                  <textarea class="form-control" id="message" name="Message" rows="5" maxlength="1000" required></textarea>
                </div>
                <p class="form-note">All fields are required.</p>
                <button class="btn-shop" type="submit">Send Message</button>
              </form>
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>