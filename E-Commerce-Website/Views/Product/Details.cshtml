@if (ViewBag.IsLoggedIn != null && (bool)ViewBag.IsLoggedIn)
{
    <!-- Agar user login hai, toh Add to Cart ka form show ho -->
    <form asp-controller="Product" asp-action="AddToCart" method="post" class="d-inline">
        <input type="hidden" name="productId" value="@Model.ProductId" />
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-bag-plus me-2"></i>Add to Cart
        </button>
    </form>
}
else
{
    <!-- Agar user login nahi hai, toh Login karne ka button show ho -->
    <a asp-controller="Account" asp-action="Login" class="btn btn-warning px-4 text-dark fw-semibold">
        <i class="bi bi-box-arrow-in-right me-2"></i>Login to Buy
    </a>
}