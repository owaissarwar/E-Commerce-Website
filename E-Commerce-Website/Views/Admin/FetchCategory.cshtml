@model IEnumerable<E_Commerce_Website.Models.Category>
@{
        Layout = "_DashboardLayout";

}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Category List</h2>
        <a asp-action="addCategory" class="btn btn-primary">Add New Category</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Category Name</th>
                <th style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryName</td>
                    <td>
                        <a asp-action="UpdateCategory" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="DeleteCategory" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger" onclick="return confirm('Aap waqai isay delete karna chahte hain?')">Delete</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>