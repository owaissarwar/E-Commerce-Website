@model IEnumerable<E_Commerce_Website.Models.Customer>

@{
    ViewData["Title"] = "Manage Admin List";
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-0 mt-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-people me-2"></i>Manage Admin List</h5>
        </div>
        <div class="card-body p-3">
            
            <!-- table-responsive lagane se mobile ya choti screen par table clean scroll hoti hai -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th class="d-none d-md-table-cell">Gender</th>
                            <th class="d-none d-md-table-cell">City</th>
                            <th class="d-none d-lg-table-cell">Address</th>
                            <th>Role</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var data in Model)
                        {
                            <tr>
                                <td>
                                    <img src="~/Upload/@data.CustomerImage" width="40" height="40" class="rounded-circle border" style="object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=256&auto=format&fit=crop'" />
                                </td>
                                <td class="fw-semibold">@data.CustomerName</td>
                                <td>@data.CustomerEmail</td>
                                <td class="d-none d-md-table-cell">@data.CustomerGender</td>
                                <td class="d-none d-md-table-cell">@data.CustomerCity</td>
                                <td class="d-none d-lg-table-cell text-muted small" style="max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@data.CustomerAddress</td>
                                <td>
                                    <span class="badge @(data.CustomerRole == "Admin" ? "bg-success" : "bg-primary")">@data.CustomerRole</span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-controller="Admin" asp-action="EditAdmin" asp-route-id="@data.CustomerId" class="btn btn-primary btn-sm" title="Edit">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="DeleteAdmin" asp-route-id="@data.CustomerId" class="btn btn-danger btn-sm" title="Delete" onclick="return confirm('Aap waqai isay delete karna chahte hain?');">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>